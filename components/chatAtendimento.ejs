<link rel="stylesheet" href="/styles/atendimento.css">
<div class="malbi-chat" id="malbiChat" data-csrf="<%= csrfToken %>" data-login="<%= usuario ? 'sim' : 'nao' %>" data-user="<%= usuario?.id || '' %>">
  <button type="button" class="malbi-chat-bolha" id="chatAlternar" aria-label="Abrir atendimento" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" width="29" height="29" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:middle">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span id="chatNotificacao" hidden>
    </span>
  </button>
  <section class="malbi-chat-janela" id="chatJanela" aria-label="Central de atendimento" hidden>
    <header class="malbi-chat-topo">
      <strong>Atendimento Malbi Doll</strong>
      <div>
        <button type="button" id="chatVoltar" aria-label="Voltar" hidden>←</button>
        <button type="button" id="chatMinimizar" aria-label="Minimizar">−</button>
        <button type="button" id="chatFechar" aria-label="Fechar">×</button>
      </div>
    </header>
    <div class="malbi-chat-conteudo" id="chatConteudo">
    </div>
    <form id="chatFormulario" class="malbi-chat-enviar" hidden>
      <textarea id="chatTexto" placeholder="Escreva sua mensagem..." maxlength="3000" rows="2" required>
      </textarea>
      <label id="chatAnexarLabel" hidden class="malbi-anexar" title="Anexar fotos">📷
        <input type="file" id="chatFotos" accept="image/jpeg,image/png,image/webp" multiple hidden>
      </label>
      <span id="chatFotosResumo" class="malbi-fotos-resumo" hidden></span>
      <button type="submit" aria-label="Enviar mensagem">➤</button>
    </form>
  </section>
</div>
<script src="/scripts/atendimento.js" defer></script>

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Conta bloqueada | Malbi Doll</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#fcfaf5;color:#29483f;font-family:'Nunito',Arial,sans-serif;text-align:center}.pagina{max-width:520px;padding:36px 22px}.logo{width:min(200px,55vw);display:block;margin:0 auto 30px;transform-origin:center center;animation:girar 8s linear infinite}@keyframes girar{to{transform:rotate(360deg)}}h1{font-size:2rem;margin:0 0 16px}p{line-height:1.6}.motivo{font-weight:700;margin-top:22px}.detalhes{white-space:pre-wrap;overflow-wrap:anywhere;margin:10px auto 0}.sair{display:inline-block;margin-top:28px;color:#3a6057;text-decoration:underline}</style></head>
  <body>
    <main class="pagina">
      <img class="logo" src="/assets/logoMalbi_verde.svg" alt="Malbi Doll">
      <h1>Sua conta foi bloqueada</h1>
      <p>O acesso à sua conta está temporariamente indisponível.</p>
      <p class="motivo"><%= motivo %></p><% if (detalhes) { %><p class="detalhes"><%= detalhes %></p><% } %><a class="sair" href="/login">Voltar ao login</a>
    </main>
  </body>
</html>
<body class="bodyPersonalizar">

    <!-- Dicionário de tradução que formata os nomes para a Lista de Seleção (Modal) -->
    <script>
        const traducoesSubcat = {
            "Fem": "Feminino", "Masc": "Masculino", "N": "Neutro",
            "CabeloCurto": "Curtos", "CabeloMedio": "Médios", "CabeloComprido": "Compridos", "CabeloPreso": "Presos",
            "Sombras": "Sombras", "Delineados": "Delineados", "Labios": "Lábios", "Blush": "Blush", "PinturaFacial": "Pintura Facial",
            "VestidoCurto": "Curtos", "VestidoMedio": "Médios", "VestidoLongo": "Longos",
            "Calcas": "Calças", "Saias": "Saias", "Shorts": "Shorts",
            "MeiaCalca": "Meia Calça", "MeiaMedia": "Médias", "MeiaCurta": "Curtas",
            "SapatoAlto": "Altos", "SapatoCurto": "Baixos",
            "Piercing": "Piercings", "Aneis": "Anéis", "Oculos": "Óculos", "Pulseira": "Pulseiras"
        };

        const catData = <%- JSON.stringify(categorias) %>;
        catData.forEach(cat => {
            cat.subcategorias.forEach(sub => {
                if(traducoesSubcat[sub.nome]) {
                    sub.nome = traducoesSubcat[sub.nome]; // Altera para o nome legível no Modal
                }
            });
        });
        window.categoriasData = catData;
    </script>

    <!-- HELPER EJS PARA BUSCAR SUB_ID E FILTRAR ITENS -->
    <% 
      function getSubId(nomeSub) {
        for (let cat of categorias) {
          let achou = cat.subcategorias.find(s => s.nome.toLowerCase() === nomeSub.toLowerCase());
          if (achou) return { catId: cat.id, subId: achou.id };
        }
        return { catId: null, subId: null };
      }

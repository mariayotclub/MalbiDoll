                        <button class="btn-deletar-item" data-id="<%= item.id %>" title="Excluir item">&times;</button>
                        <div class="svg-wrapper">
                            <% if (item.imagem && item.imagem.startsWith('data:image')) { %>
                                <img src="<%= item.imagem %>" alt="<%= item.nome %>" style="width: 100%; height: 100%; object-fit: contain;" />
                            <% } else { %>
                                <%- item.imagem %>
                            <% } %>
                        </div>
                        <div class="item-info">
                            <p><%= item.nome %></p>
                            <small>R$ <%= parseFloat(item.preco).toFixed(2).replace('.', ',') %></small>
                        </div>
                    </div>
                <% }) %>
                <button class="btn-card-add btn-abrir-modal" data-categoria-id="<%= infoLuvas.catId %>" data-subcategoria-id="<%= infoLuvas.subId %>">+</button>
            </div>
        </div>


        <!-- EXTRAS -->
        <div id="catExtra">
            <div class="titulo-container">
                <div class="titulo">Extras</div>
                <div class="subtitulo">Geral</div>
            </div>

            <div class="linhaSubCat">
            </div>

            <% let infoGeral = getSubId('Geral'); %>
            <div class="displayItens" id="catGeral" style="display: flex;">
                <% itens.filter(i => i.subcategoria_id === infoGeral.subId).forEach(item => { %>
                    <div class="item-card">
                        <button class="btn-deletar-item" data-id="<%= item.id %>" title="Excluir item">&times;</button>
                        <div class="svg-wrapper">
                            <% if (item.imagem && item.imagem.startsWith('data:image')) { %>
                                <img src="<%= item.imagem %>" alt="<%= item.nome %>" style="width: 100%; height: 100%; object-fit: contain;" />
                            <% } else { %>
                                <%- item.imagem %>
                            <% } %>
                        </div>
                        <div class="item-info">
                            <p><%= item.nome %></p>
                            <small>R$ <%= parseFloat(item.preco).toFixed(2).replace('.', ',') %></small>
                        </div>
                    </div>
                <% }) %>
                <button class="btn-card-add btn-abrir-modal" data-categoria-id="<%= infoGeral.catId %>" data-subcategoria-id="<%= infoGeral.subId %>">+</button>
            </div>
        </div>

    </div>


    <!-- MENU DE BOTÕES LATERAIS -->
    <div class="botoes">
        <button id="Corpo" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Rosto" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Cabelo" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Maquiagem" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Top" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Vestido" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Bottom" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Meia" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Sapato" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Acessorio" class="categoria" onclick="trocarCat(this)"></button>
        <button id="Extra" class="categoria" onclick="trocarCat(this)"></button>
    </div>

    
    <div id="bonecaContainer" class="bonecaContainer" style="width: 635px; height: 893px;">
        <script class="oi" src="/scripts/personalizaCorpo.js" defer></script>
    </div>


    <!-- MODAL ÚNICO DE CADASTRO -->
    <div id="modalItem" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Cadastrar Novo Item</h3>
                <button id="btnFecharModal" class="close-btn">&times;</button>
            </div>

            <form id="formCadastrarItem" action="/armario/item" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="categoria_select">Categoria:</label>
                    <select id="categoria_select" required>
                        <% categorias.forEach(cat => { %>
                            <option value="<%= cat.id %>"><%= cat.nome %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="subcategoria_id">Subcategoria:</label>
                    <select id="subcategoria_id" name="subcategoria_id" required>
                        <option value="">Selecione primeiro uma Categoria</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="nome">Nome do Item:</label>
                    <input type="text" id="nome" name="nome" required placeholder="Ex: Camiseta Rosa">
                </div>

                <div class="form-group">
                    <label for="descricao">Descrição:</label>
                    <textarea id="descricao" name="descricao" rows="2" placeholder="Opcional"></textarea>
                </div>

                <div class="form-group">
                    <label for="preco">Preço (R$):</label>
                    <input type="number" id="preco" name="preco" step="0.01" value="0.00">
                </div>

                <div class="form-group">
                    <label for="imagemInput">Arquivo Imagem (.SVG):</label>
                    <input type="file" id="imagemInput" accept=".svg" required>
                    <input type="hidden" id="imagemProcessada" name="imagem">
                </div>

                <!-- ÁREA DE PRÉ-VISUALIZAÇÃO DO CROPPER -->
                <div class="form-group" id="containerCropper" style="display: none; text-align: center;">
                    <label>Ajuste o enquadramento para o Card:</label>
                    <div style="max-width: 100%; height: 180px; margin: 0 auto; overflow: hidden; background: #eee;">
                        <img id="imagePreview" style="max-width: 100%; display: block;" />
                    </div>
                    <small style="color: #666; margin-top: 4px; display: block;">Arraste para mover ou dê zoom</small>
                </div>

                <div class="form-group">
                    <label for="z_index">Camada (Z-Index):</label>
                    <input type="number" id="z_index" name="z_index" value="1">
                </div>

                <button type="submit" class="btn-modal-salvar">Salvar Item</button>
            </form>
        </div>
    </div>

    <!-- MODAL CUSTOMIZADO DE CONFIRMAÇÃO DE EXCLUSÃO -->
    <div id="modalConfirmacao" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="text-align: center; width: 320px;">
            <div class="modal-header" style="justify-content: center;">
                <h3 style="margin: 0;">Excluir Item</h3>
            </div>
            <p style="margin: 15px 0; color: #1a4d38; font-weight: 500;">Tem certeza de que deseja excluir este item?</p>
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <button type="button" id="btnCancelarExclusao" class="btn-modal-salvar" style="background-color: #ccc; border-color: #888; margin-top: 0;">Cancelar</button>
                <button type="button" id="btnConfirmarExclusao" class="btn-modal-salvar" style="background-color: #e63946; color: #fff; border-color: #b71c1c; margin-top: 0;">Excluir</button>
            </div>
        </div>
    </div>

</body>

</html>
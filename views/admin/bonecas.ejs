<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gerenciar bonecas NP | Malbi Doll</title>
  <%- include('../../components/lojaHead') %>
</head>
<body>
  <%- include('../../components/cabecalho') %>

  <main class="loja-main secao-loja">
    <a href="/admin" class="link-verde">← Voltar ao painel</a>
    <span class="etiqueta">ADMINISTRAÇÃO</span>
    <h1>Bonecas prontas (NP)</h1>
    <p>Cadastre, edite ou remova as bonecas do catálogo.</p>

    <div class="admin-layout">
      <section class="form-admin">
        <h2>Adicionar boneca</h2>
        <form action="/admin/bonecas" method="post" enctype="multipart/form-data">
          <label>Nome
            <input name="nome" maxlength="120" required>
          </label>
          <label>Descrição
            <textarea name="descricao" rows="5" maxlength="5000"></textarea>
          </label>
          <label>Preço (R$)
            <input type="number" name="preco" min="0" max="99999999" step="0.01" required>
          </label>
          <label>Imagem PNG, JPG, WEBP ou GIF (até 3 MB)
            <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp,image/gif" required>
          </label>
          <label class="check">
            <input type="checkbox" name="ativo" checked> Visível na loja
          </label>
          <button type="submit" class="botao-verde">Cadastrar boneca</button>
        </form>
      </section>

      <section class="admin-lista">
        <h2>Bonecas cadastradas (<%= bonecas.length %>)</h2>

        <% if (!bonecas.length) { %>
          <p>Nenhuma boneca cadastrada.</p>
        <% } %>

        <% bonecas.forEach(b => { %>
          <article class="admin-item">
            <img src="/bonecas/<%= b.id %>/imagem" alt="" onerror="this.style.visibility='hidden'">
            <div>
              <h3><%= b.nome %></h3>
              <p>
                <%= moeda(b.preco) %> · <%= b.ativo ? 'Publicada' : 'Oculta' %>
              </p>
              <p>
                <%= b.total_avaliacoes %> avaliações
              </p>

              <details>
                <summary>Editar boneca</summary>
                <form action="/admin/bonecas/<%= b.id %>/editar" method="post" enctype="multipart/form-data">
                  <label>Nome
                    <input name="nome" maxlength="120" value="<%= b.nome %>" required>
                  </label>
                  <label>Descrição
                    <textarea name="descricao" maxlength="5000" rows="3"><%= b.descricao %></textarea>
                  </label>
                  <label>Preço
                    <input name="preco" type="number" step="0.01" min="0" max="99999999" value="<%= b.preco %>" required>
                  </label>
                  <label>Trocar imagem (opcional)
                    <input name="imagem" type="file" accept="image/png,image/jpeg,image/webp,image/gif">
                  </label>
                  <label class="check">
                    <input type="checkbox" name="ativo" <%= b.ativo ? 'checked' : '' %>> Visível na loja
                  </label>
                  <button class="botao-verde" type="submit">Salvar alterações</button>
                </form>
              </details>

              <form action="/admin/bonecas/<%= b.id %>/excluir" method="post" onsubmit="return confirm('Excluir esta boneca e todas as avaliações?')">
                <button class="botao-texto" type="submit">Excluir</button>
              </form>
            </div>
          </article>
        <% }) %>
      </section>
    </div>
  </main>

  <%- include('../../components/carrinho') %>
</body>
</html>